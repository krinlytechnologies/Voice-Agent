# Copy to .env (never commit real values). Server-only secrets must not use a VITE_ prefix.

# Local PostgreSQL 16 from docker-compose.yml (host port 5434 avoids existing services on 5432/5433).
# Only these URLs change when the database moves to Supabase or Cloudflare.
DATABASE_URL="postgresql://mona:mona_local_only@localhost:5434/mona?schema=public"
DATABASE_URL_TEST="postgresql://mona:mona_local_only@localhost:5434/mona_test?schema=public"

# External Python voice engine (separate deployment). Server-only.
# Local engine: VOICE_ENGINE_BASE_URL="http://127.0.0.1:8000" (not the ngrok URL, which is for Exotel).
VOICE_ENGINE_BASE_URL=""
# The engine's APP_SECRET_KEY.
VOICE_ENGINE_API_KEY=""
# Must equal the engine's DASHBOARD_WEBHOOK_SECRET. Results are rejected unless signed with it.
VOICE_ENGINE_WEBHOOK_SECRET=""
VOICE_ENGINE_CREDITS_PER_MINUTE="1"
# Where the engine can reach this app to deliver results (no trailing slash). Match the dev server's port.
APP_BASE_URL="http://localhost:8080"
